# Copy this file to ".env" (local) or add these in your host's Environment Variables (deployed).
# After changing them, restart "npm run dev" or rebuild - Vite reads them at build time.

# Backend address only. NO trailing slash and NO "/api" at the end.
VITE_API_URL=http://localhost:5000

# Optional. Only set if the Socket.IO server is on a different address than the API.
# VITE_SOCKET_URL=http://localhost:5000
